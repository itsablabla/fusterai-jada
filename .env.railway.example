# FusterAI on Railway — reference variables (do NOT commit real secrets)

APP_NAME=FusterAI
APP_ENV=production
APP_DEBUG=false
# Generate with: openssl rand -base64 32
APP_KEY=
APP_URL=https://${RAILWAY_PUBLIC_DOMAIN}
SESSION_SECURE_COOKIE=true

# Database
DB_CONNECTION=pgsql
DB_URL=${{Postgres.DATABASE_URL}}
DB_SSLMODE=prefer

# Redis (cache, queue, sessions, broadcasting)
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_CLIENT=phpredis
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
HORIZON_DRIVER=redis

# Reverb WebSockets — Caddy proxies /app,/apps on the public domain
REVERB_APP_ID=fusterai
REVERB_APP_KEY=          # openssl rand -hex 16
REVERB_APP_SECRET=       # openssl rand -hex 16
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
VITE_REVERB_APP_KEY=${REVERB_APP_KEY}

# Search (database is safe default; switch to meilisearch if you add the service)
SCOUT_DRIVER=database

# Storage (persists on the Railway volume mounted at /var/www/html/storage)
FILESYSTEM_DISK=local

# Mail — start with 'log'; swap to real SMTP (Resend/Postmark/SES) in Settings
MAIL_MAILER=log

# AI (optional — leave empty to disable AI features until configured in-app)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# CORS — restrict to your public domain in production
CORS_ALLOWED_ORIGINS=https://${RAILWAY_PUBLIC_DOMAIN}

# Logging → Railway
LOG_CHANNEL=stderr

# Runtime
PHP_MEMORY_LIMIT=512M
FUSTERAI_SEED_DEMO=false
